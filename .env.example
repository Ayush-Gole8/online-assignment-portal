# ===========================================================================
# Environment template for local development.
#
#   cp .env.example .env      # then replace every `change-me` value
#
# `.env` is git-ignored (see .gitignore). This file is committed and must contain
# VARIABLE NAMES AND PLACEHOLDERS ONLY — never a real credential (CLAUDE.md §7,
# SECURITY.md §5).
#
# These are the same variable names the application reads in every environment.
# In CI they come from the Jenkins credentials store; at deploy time from Ansible
# Vault or the target host environment. Nothing is ever committed.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Public HTTP port the application binds. Read as APP_PORT in application.yml.
APP_PORT=8080

# Root directory for uploaded artefacts. Bytes live here on a persistent volume;
# only metadata lives in MySQL (ADR-004). Read as UPLOAD_STORAGE_PATH.
UPLOAD_STORAGE_PATH=./uploads

# ---------------------------------------------------------------------------
# Upload limits — one variable, read by two settings in application.yml
# ---------------------------------------------------------------------------
#
# These all have defaults in application.yml and none is a secret, so leaving them
# commented out is the normal case. They are listed because changing them is how
# the limits are changed, and because one of them is read from two places.
#
# `spring.servlet.multipart.max-file-size` (what the servlet container's parser
# accepts) and `app.upload.max-file-size` (what the validator enforces) both
# resolve from this one variable, and they must move together. If the parser's
# limit were the lower of the two, an upload would be stopped by the container and
# answered with a sentence naming the validator's limit — a size that did not
# refuse it. UiRenderingIT.appliesTheSameUploadLimitInBothPlacesThatReadIt is what
# keeps the two in step.
#
# The default is 10MB. Raising it changes a security control, so it needs the ADR
# that CLAUDE.md §7 rule 4 requires — not merely an edit here.
# UPLOAD_MAX_FILE_SIZE=10MB

# The whole request, not only the file: the multipart envelope plus the title and
# course code. Must stay larger than UPLOAD_MAX_FILE_SIZE, or an upload at the
# limit is refused by the container for a reason the page cannot explain.
# UPLOAD_MAX_REQUEST_SIZE=11MB

# The accepted media type. `application/pdf` is the only value the application can
# actually prove — FileValidationService checks for the %PDF- signature in the
# bytes, and that check is written for PDF. Any other value is refused at startup
# with a message saying so, rather than accepted and then rejected on every upload.
# UPLOAD_ALLOWED_CONTENT_TYPE=application/pdf

# ---------------------------------------------------------------------------
# Container stack — read by compose.yaml only
# ---------------------------------------------------------------------------

# Host port the application container is published on. The container itself
# always listens on 8080; this is the port it is reachable on from the host.
# Defaults to 8081 rather than 8080 because Jenkins owns 8080 on the machine
# that runs this pipeline (scripts/ci/env.cmd).
# APP_HOST_PORT=8081

# The image tag the `app` service runs. `local` is right for a laptop. Never
# `latest` (ADR-006): a tag that moves is not a version.
#
# Do not set this to a release version here. On a deployment host the tag is
# WRITTEN BY THE RELEASE PIPELINE into that host's own `.env`, and that file is
# a different one from this template — see deploy/env.production.example and
# docs/operations/docker-cd.md §5.
# APP_IMAGE_TAG=local

# Which environment this is, reported at /actuator/info. Left unset it reports
# `unknown`, which is the honest answer for a laptop: the value is a deployment's
# business, and the pipeline sets it there from the DEPLOY_ENV build parameter.
# APP_ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Database — consumed by BOTH the application and compose.yaml
# ---------------------------------------------------------------------------

# JDBC URL the application connects with. Read as DB_URL when the application
# runs ON THE HOST (`./mvnw spring-boot:run`). compose.yaml deliberately does
# NOT read this value: inside the Compose network `localhost` is the application
# container itself, so the `app` service builds `jdbc:mysql://db:3306/...` from
# DB_NAME instead. See docs/operations/docker.md §7.
DB_URL=jdbc:mysql://localhost:3306/assignment_portal

# Application database user, created by the MySQL image on first start.
# Read as DB_USERNAME. Must match the user created by Compose.
DB_USERNAME=assignment_portal

# Password for the application database user. Read as DB_PASSWORD.
# The application has NO default for this: if it is unset, startup fails.
DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Database — consumed by compose.yaml only
# ---------------------------------------------------------------------------

# Host port MySQL is published on, bound to loopback. Change it if 3306 is already
# in use locally; DB_URL above must then use the same port.
DB_PORT=3306

# Database name created on first start. Must match the database in DB_URL.
# Optional — defaults to `assignment_portal`.
DB_NAME=assignment_portal

# Password for the MySQL `root` account. Used only by the container's first-start
# initialisation and its healthcheck; the application never connects as root.
DB_ROOT_PASSWORD=change-me-root

# ---------------------------------------------------------------------------
# Session (read as SESSION_TIMEOUT and SESSION_COOKIE_SECURE in application.yml)
# ---------------------------------------------------------------------------

# How long an idle session survives. ADR-005 requires this to be configuration
# rather than a hard-coded value, so local and deployed environments can differ.
SESSION_TIMEOUT=30m

# Whether the session cookie carries the Secure attribute. Must be `true` in any
# environment served over HTTPS. Left `false` locally because a Secure cookie is
# not sent over plain http://, which would silently break sign-in on localhost.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Development seed accounts — NEVER set these outside local development
# ---------------------------------------------------------------------------
#
# These create one demo account per role at startup. Four conditions must ALL hold
# before anything is created:
#
#   1. the `dev` profile is active, and
#   2. APP_SEED_ENABLED=true, and
#   3. APP_SEED_<ROLE>_EMAIL is set, and
#   4. APP_SEED_<ROLE>_PASSWORD is set.
#
# There is no default password anywhere in the code. An account whose password
# variable is unset is simply not created — the application warns and moves on.
# That is what stops this from ever becoming a production credential: the worst
# case in a misconfigured deployment is an empty table, never a known password.
#
# Leave APP_SEED_ENABLED unset or `false` in every shared environment.
APP_SEED_ENABLED=false

APP_SEED_STUDENT_EMAIL=
APP_SEED_STUDENT_PASSWORD=

APP_SEED_REVIEWER_EMAIL=
APP_SEED_REVIEWER_PASSWORD=

APP_SEED_ADMIN_EMAIL=
APP_SEED_ADMIN_PASSWORD=
