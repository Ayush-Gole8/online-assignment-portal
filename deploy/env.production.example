# ===========================================================================
# The deployment host's `.env` — variable NAMES and placeholders only.
#
#   cp deploy/env.production.example /opt/assignment-portal/.env
#   # then replace every `change-me` value ON THE HOST, and never commit it
#
# This file is named `env.production.example` and not `.env.production.example`
# on purpose: `.gitignore` ignores `.env.*` at every level, and the one negation
# it carries (`!.env.example`) matches that exact name only. A file called
# `.env.production.example` inside `deploy/` would therefore be ignored and
# silently never committed, which is a worse outcome than an unconventional
# filename.
#
# ---------------------------------------------------------------------------
# Two of these variables are written by the release process, and the rest are
# not. The line matters, so it is drawn explicitly:
#
#   OWNED BY THE HOST (set once, by whoever provisions the host)
#     DB_NAME, DB_USERNAME, DB_PASSWORD, DB_ROOT_PASSWORD, IMAGE_REPOSITORY,
#     and any optional override listed below.
#     These are the deployment's secrets and its identity. They never pass
#     through Jenkins, and the pipeline never reads them.
#
#   WRITTEN BY THE PIPELINE, ON EVERY RELEASE
#     APP_IMAGE_TAG and APP_ENVIRONMENT.
#     deploy/deploy-on-host.sh replaces exactly these two lines and appends them
#     if they are absent. It rewrites no other line, so a credential placed in
#     this file is not disturbed by a deployment — and nothing in this file
#     needs to be readable by Jenkins for a release to work.
#
# See docs/operations/docker-cd.md §5 for the full contract.
# ===========================================================================

# ---------------------------------------------------------------------------
# Image identity (host-owned)
# ---------------------------------------------------------------------------

# The Docker Hub repository the deployment pulls from, as `<account>/<name>`.
# The registry itself is not written: Docker Hub is Docker's default registry,
# and spelling it out would only be a longer way to say the same thing. This is
# read by deploy/compose.prod.yaml, which composes the full image reference as
# `${IMAGE_REPOSITORY}:${APP_IMAGE_TAG}`.
#
# It is host-owned rather than pipeline-supplied because it is a property of
# where the image is published, not of any one release — and because a host that
# could be told to pull from an arbitrary repository by a build parameter is a
# host that can be pointed at an image nobody reviewed.
IMAGE_REPOSITORY=change-me/assignment-portal

# The version of the image this host runs. WRITTEN BY THE PIPELINE — it is the
# git tag of the release, without the leading `v` (tag `v1.0.1` -> `1.0.1`).
#
# It is present here, with a placeholder, only so the file is complete and so a
# first manual start has something to fail on. Never `latest`: a release is
# identified by a version that can be named again (ADR-006).
APP_IMAGE_TAG=change-me

# Which environment this is. WRITTEN BY THE PIPELINE, from the Jenkins
# DEPLOY_ENV parameter. Published by the application at /actuator/info, so that
# "which environment am I looking at" is answered by the thing being looked at.
#
# Allowed values: staging, production. A host is one of them for its lifetime;
# nothing deploys a release whose DEPLOY_ENV does not match where it is.
APP_ENVIRONMENT=change-me

# ---------------------------------------------------------------------------
# Database (host-owned, SECRET)
# ---------------------------------------------------------------------------
#
# These four create the database on the container's first start. DB_PASSWORD is
# also what the application connects with, so the two cannot be allowed to
# differ — they are read from this one file by both services.
#
# There is no default for either password anywhere: not in application.yml, not
# in compose.prod.yaml, not in this example. A missing one stops the stack from
# starting, which is the intended outcome. Generate them on the host; do not
# copy them from a document, a ticket, or a chat message.

DB_NAME=assignment_portal
DB_USERNAME=assignment_portal
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# ---------------------------------------------------------------------------
# Published address (host-owned, optional)
# ---------------------------------------------------------------------------

# Host port the application is published on. The container always listens on
# 8080 whatever this says.
# APP_HOST_PORT=8080

# Interface the application port is bound to. Defaults to every interface, so
# that the pipeline's smoke test can reach the deployment over the network.
# A host with a reverse proxy in front of the application should set this to
# 127.0.0.1 so the application is reachable only through the proxy.
# APP_BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------------------
# Application settings (host-owned, optional)
# ---------------------------------------------------------------------------
#
# Every one of these has the same default in application.yml, so leaving them
# commented out is the normal case. They are listed because they are the
# settings a given host is allowed to differ on.

# How long an idle session survives. ADR-005 requires this to be configuration.
# SESSION_TIMEOUT=30m

# The session cookie's Secure attribute. MUST be `true` on any host served over
# HTTPS — a Secure cookie is not sent over plain http://, which is a protection
# when the connection is encrypted and a broken sign-in page when it is not.
# Set this in the same change that terminates TLS. See compose.prod.yaml.
# SESSION_COOKIE_SECURE=true

# Active Spring profiles. Empty means none, which is what a deployment wants —
# the `dev` profile is what enables the demo-account seeder, and a deployment
# must never activate it. Listed so that nobody sets it by accident thinking it
# is required.
# SPRING_PROFILES_ACTIVE=

# ---------------------------------------------------------------------------
# DELIBERATELY ABSENT
# ---------------------------------------------------------------------------
#
# There is no APP_SEED_* variable here, and their absence is a control rather
# than an omission. DevelopmentUserSeeder needs three conditions at once — the
# `dev` profile, APP_SEED_ENABLED=true, and a password for the account — and
# two of the three are on this list only if someone adds them. A deployment that
# never mentions them cannot seed a demo account with a guessable password.
#
# There is also no JAVA_TOOL_OPTIONS. The image sets a heap-sizing default that
# follows the container's memory limit; a host that needs a different one sets
# it here explicitly, having decided what it needs.
