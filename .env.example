# ===========================================================================
# Environment template for local development.
#
#   cp .env.example .env      # then replace every `change-me` value
#
# `.env` is git-ignored (see .gitignore). This file is committed and must contain
# VARIABLE NAMES AND PLACEHOLDERS ONLY — never a real credential (CLAUDE.md §7,
# SECURITY.md §5).
#
# These are the same variable names the application reads in every environment.
# In CI they come from the Jenkins credentials store; at deploy time from Ansible
# Vault or the target host environment. Nothing is ever committed.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Public HTTP port the application binds. Read as APP_PORT in application.yml.
APP_PORT=8080

# Root directory for uploaded artefacts. Bytes live here on a persistent volume;
# only metadata lives in MySQL (ADR-004). Read as UPLOAD_STORAGE_PATH.
UPLOAD_STORAGE_PATH=./uploads

# ---------------------------------------------------------------------------
# Database — consumed by BOTH the application and deploy/docker-compose.yml
# ---------------------------------------------------------------------------

# JDBC URL the application connects with. Read as DB_URL.
DB_URL=jdbc:mysql://localhost:3306/assignment_portal

# Application database user, created by the MySQL image on first start.
# Read as DB_USERNAME. Must match the user created by Compose.
DB_USERNAME=assignment_portal

# Password for the application database user. Read as DB_PASSWORD.
# The application has NO default for this: if it is unset, startup fails.
DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Database — consumed by deploy/docker-compose.yml only
# ---------------------------------------------------------------------------

# Host port MySQL is published on, bound to loopback. Change it if 3306 is already
# in use locally; DB_URL above must then use the same port.
DB_PORT=3306

# Database name created on first start. Must match the database in DB_URL.
# Optional — defaults to `assignment_portal`.
DB_NAME=assignment_portal

# Password for the MySQL `root` account. Used only by the container's first-start
# initialisation and its healthcheck; the application never connects as root.
DB_ROOT_PASSWORD=change-me-root
