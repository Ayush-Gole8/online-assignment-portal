<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.vit</groupId>
  <artifactId>online-assignment-portal</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>online-assignment-portal</name>
  <description>Git-Driven Online Assignment Submission Portal</description>

  <!--
    Version policy (CLAUDE.md §3): the stack is fixed and every version is pinned.
    Spring Boot's parent (via spring-boot-dependencies) supplies managed versions for
    Spring MVC, Thymeleaf, JPA, Validation, Actuator, Flyway, MySQL Connector/J, JUnit 5
    and Testcontainers, so no child dependency below declares its own version.
  -->
  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      The JUnit tag names that partition the suite, in one place so the build and the test
      sources cannot drift. The matching constants are com.vit.assignmentportal.support.
      TestCategories; if you rename one, rename it in both, because nothing here reads the
      Java constant and nothing there reads this property
      (docs/testing/test-strategy.md §3).
    -->
    <test.group.unit>unit</test.group.unit>
    <test.group.integration>integration</test.group.integration>
    <test.group.e2e>e2e</test.group.e2e>

    <!--
      What each phase refuses to run.

      Surefire runs the unit phase, so it excludes the two slower categories. Failsafe runs
      the integration phase, so it excludes only the browser suite — the browser suite is the
      one that needs a running deployment, and it is the only category a plain `verify` must
      never start (docs/testing/strategy.md §3.3).
    -->
    <surefire.excluded.groups>${test.group.integration},${test.group.e2e}</surefire.excluded.groups>
    <failsafe.excluded.groups>${test.group.e2e}</failsafe.excluded.groups>
  </properties>

  <dependencies>

    <!-- ===================== Web / view layer ===================== -->
    <!-- Spring MVC on embedded Tomcat plus the Jackson/validation web support. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Server-rendered views (ADR-002). No SPA, no separate frontend build. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <!-- ===================== Persistence ===================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!--
      Flyway runs schema migrations at startup. ddl-auto is pinned to `validate`
      (application.yml), so Hibernate validates and never creates or alters schema.
      See ADR-003.

      Spring Boot 4 split the monolithic `spring-boot-autoconfigure` into per-technology
      modules, and Flyway's autoconfiguration now lives in `spring-boot-flyway`. Declaring
      only `org.flywaydb:flyway-core` puts the library on the classpath but leaves nothing
      to call it: the context starts cleanly, no migration runs, and the failure surfaces
      later as "Table 'users' doesn't exist". The starter supplies the autoconfiguration.

      flyway-core stays declared explicitly alongside it. The starter's transitive
      contents are not something this build has verified, and a missing library here
      reproduces exactly the same silent no-op. A redundant declaration costs nothing.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <!--
      Flyway 10+ moved per-database support into separate modules, and no starter brings
      them. MySQL migrations fail with "Unsupported Database: MySQL" without this.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ===================== Bean Validation ===================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ===================== Security ===================== -->
    <!--
      Session-based form authentication (ADR-005). This brings Spring Security itself plus
      `spring-boot-security`, the module that carries SecurityAutoConfiguration.

      Boot 4's module split makes that second part worth stating, because the same trap as
      Flyway below applies here. Declaring only a library leaves nothing to call it: the
      context starts, the feature silently does not. `spring-boot-starter-security` is what
      wires the filter chain into the servlet context. CSRF protection, session-fixation
      protection and the HttpOnly JSESSIONID cookie all arrive enabled from that
      autoconfiguration; config/SecurityConfiguration narrows them explicitly rather than
      switching them on.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- ===================== Operability ===================== -->
    <!-- Supplies /actuator/health, the pipeline's health-check stage target (FR-25). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ===================== Test ===================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      The Spring Security test support: `csrf()` and the SecurityMockMvcConfigurer that
      applies the real filter chain under MockMvc. Without it the security tests would have
      to hand-place an Authentication into the SecurityContext, which tests the test rather
      than the configuration (docs/testing/strategy.md §3.3).

      One correction worth recording, because this comment previously claimed otherwise:
      SecurityMockMvcRequestPostProcessors has no `user(UserDetails)` overload on Spring
      Security 7.1.1 — the compiler rejects it. `csrf()` from the same class resolves, so
      the dependency is right; the method simply is not there. AuthorizationIT therefore
      signs in for real, posting credentials to /login and reusing the session that comes
      back. That is the better test anyway: it exercises DatabaseUserDetailsService, the
      Role enum, and `hasRole(...)` end to end instead of handing the filter chain an
      authority it did not produce.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      MockMvc and the web-layer test slices (@AutoConfigureMockMvc).

      This is the same Boot 4 module split as Flyway above, and it bites in the same silent
      way. `spring-boot-starter-test` brings JUnit, AssertJ, Mockito and
      `spring-boot-test-autoconfigure` — but NOT the web test slice, which Boot 4 moved into
      its own module. Without this, `org.springframework.boot.test.autoconfigure.web.servlet`
      simply does not exist, and the failure is a missing symbol in a test source rather
      than anything that looks like a dependency problem.

      On Spring Boot 4, a test slice needs its `spring-boot-starter-<technology>-test`
      module. This is the webmvc one; a JPA slice would be `spring-boot-starter-data-jpa-test`,
      and so on (ADR-003).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Testcontainers runs the integration tests against a real MySQL 8.4 rather than H2,
      so migrations and constraints are exercised on the engine that ships (ADR-003,
      docs/testing/strategy.md §3.2).

      Note the artifact ids. Testcontainers 2.x renamed its modules to carry the
      `testcontainers-` prefix — `testcontainers-mysql`, not the 1.x `mysql`. Spring Boot
      4.1.1 manages Testcontainers 2.0.5. Versions stay unmanaged here: the BOM decides.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!-- Builds the executable JAR and provides `mvn spring-boot:run` (ADR-002). -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Enforce Java 21 explicitly rather than relying on the parent's conventions.
        A build on the wrong JDK fails immediately with a clear message instead of
        producing classes compiled to an unexpected bytecode level.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-java-21</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <!--
                    Maven selects its JDK from JAVA_HOME, and falls back to java.exe on PATH
                    when JAVA_HOME is unset. On a machine where a newer JDK is first on PATH,
                    this rule is what catches it — before any class is compiled, so the
                    failure is unambiguous.

                    The message is deliberately ASCII-only and actionable: it is read at the
                    exact moment a build fails, possibly by someone who has never seen this
                    project before.
                  -->
                  <message>
                    Requires a JDK 21 to build, but Maven is running on a different JDK. Maven
                    picks its JDK from JAVA_HOME, then from java.exe on PATH. Set JAVA_HOME to
                    the ROOT of a JDK 21 (not its bin directory, not java.exe) and re-run.
                    Check which JDK is in use with: mvn -version
                  </message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        The test pyramid, split across two plugins by convention and confirmed by tag.

        Surefire runs the unit phase (`test`) over *Test; Failsafe runs the integration
        phase (`integration-test`, `verify`) over *IT, so `./mvnw clean verify` covers both
        (docs/testing/strategy.md §5). The class-name convention and the JUnit tag say the
        same thing — *Test is tagged `unit`, *IT is tagged `integration`, a future *E2E is
        tagged `e2e` — and the `excludedGroups` below makes the build honour the tag as well
        as the name (docs/testing/test-strategy.md).

        `excludedGroups` and not `groups`, deliberately. An incremental `groups` filter
        silently drops any test whose author forgot to tag it; an `excludedGroups` filter
        only ever withholds a test from the phase that must not run it, so a forgotten tag
        costs nothing and a browser test misnamed `SomethingIT` still cannot run under
        `verify`.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${surefire.excluded.groups}</excludedGroups>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <excludedGroups>${failsafe.excluded.groups}</excludedGroups>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <!--
      The explicit way to run the end-to-end suite later: ./mvnw clean verify -Pe2e

      Selenium is not a dependency yet and no *E2E test exists, so this profile is the
      mechanism and not yet the evidence for anything. It is a separate profile because the
      browser suite needs a running deployment and takes minutes rather than seconds
      (docs/testing/strategy.md §3.3), so it must never be something a plain `verify` can
      start by accident — the profile has to be named, and naming it is the acknowledgement
      that a browser and a live server are wanted.

      `failIfNoTests` is false so the profile is inert until the first *E2E test lands,
      rather than turning a pipeline stage red for a test nobody has written yet.
    -->
    <profile>
      <id>e2e</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>e2e-tests</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>**/*E2E.java</include>
                  </includes>
                  <groups>${test.group.e2e}</groups>
                  <!--
                    Overrides the plugin-level exclusion, which is `e2e` — without this the
                    parent configuration would exclude the very group this execution selects.
                  -->
                  <excludedGroups>${test.group.integration}</excludedGroups>
                  <failIfNoTests>false</failIfNoTests>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
