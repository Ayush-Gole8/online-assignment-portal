# ===========================================================================
# The deployment host's environment — rendered by Ansible from group_vars.
#
# Rendered by roles/application/tasks/main.yml (no_log), readable by the portal
# group and nobody else (0640).
#
# This file is the SAME interface the CD pipeline writes to. deploy-on-host.sh
# rewrites exactly two of the keys below — APP_IMAGE_TAG and APP_ENVIRONMENT — with
# `sed`, and appends them if they are absent. They are present here, so the
# pipeline edits these lines rather than adding a second copy of them. Everything
# else in this file is the host's, and the pipeline does not touch it
# (docs/operations/docker-cd.md §5).
#
# The variables composed here are the ones deploy/compose.prod.yaml reads. Its
# `${VAR:?...}` forms mean a key missing from this file STOPS the stack from
# starting and names the missing variable, rather than starting one that will fail
# later. Nothing below is a value that could be half-set.
# ===========================================================================

# ---------------------------------------------------------------------------
# Image identity
# ---------------------------------------------------------------------------

# The Docker Hub repository the deployment pulls from, as <account>/<name>.
IMAGE_REPOSITORY={{ image_repository }}

# The version this host runs. Never `latest` (ADR-006). Ansible writes the value
# it converged to; the CD pipeline overwrites this line on every release.
APP_IMAGE_TAG={{ app_image_tag }}

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# Which environment this is. Published at /actuator/info and asserted by the smoke
# test, so the deployment answers "where am I" for itself.
APP_ENVIRONMENT={{ app_environment }}

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DB_NAME={{ db_name }}
DB_USERNAME={{ db_username }}
DB_PASSWORD={{ db_password }}
DB_ROOT_PASSWORD={{ db_root_password }}

# ---------------------------------------------------------------------------
# Published address
# ---------------------------------------------------------------------------

# The container always listens on 8080; this is the host port it is reachable on.
APP_HOST_PORT={{ app_host_port }}

# The interface the port is bound to. 127.0.0.1 when a reverse proxy terminates TLS
# in front of the application.
APP_BIND_ADDRESS={{ app_bind_address }}

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------

SPRING_PROFILES_ACTIVE={{ spring_profiles_active }}

SESSION_TIMEOUT={{ session_timeout }}

# The Secure cookie attribute. `true` on any host served over HTTPS; a Secure
# cookie is not sent over plain http://. Set true in the same change that adds a
# TLS terminator, never later (docs/operations/docker-cd.md §9).
SESSION_COOKIE_SECURE={{ session_cookie_secure | bool | lower }}

UPLOAD_MAX_FILE_SIZE={{ upload_max_file_size }}
UPLOAD_MAX_REQUEST_SIZE={{ upload_max_request_size }}
